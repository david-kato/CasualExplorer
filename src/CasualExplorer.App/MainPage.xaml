<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CasualExplorer.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:CasualExplorer.Models"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
    <Grid Padding="32" RowSpacing="16" MinHeight="800">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="700" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SourceButtons.Orientation" Value="Horizontal" />
                        <Setter Target="PreviewButtons.Orientation" Value="Horizontal" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="CasualExplorer v0.1" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="同梱ダミー、または選んだローカルフォルダの直下を読取り専用で表示" TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Grid.Column="1"
                Padding="14,7"
                Background="#0F6CBD"
                CornerRadius="16"
                VerticalAlignment="Center">
                <TextBlock
                    Foreground="White"
                    FontWeight="SemiBold"
                    Text="読取り専用" />
            </Border>
        </Grid>

        <InfoBar
            Grid.Row="1"
            IsClosable="False"
            IsOpen="True"
            Message="移動、コピー、名前変更、削除、上書き、暗号化は行いません。"
            Severity="Informational"
            Title="安全モード" />

        <StackPanel Grid.Row="2" Spacing="4">
            <TextBlock FontWeight="SemiBold" Text="対象" />
            <TextBlock
                x:Name="TargetFolderText"
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="同梱ダミーフォルダ: Samples\TestData" />
        </StackPanel>

        <StackPanel Grid.Row="3" Spacing="8">
          <StackPanel x:Name="SourceButtons" Orientation="Vertical" HorizontalAlignment="Left" Spacing="8">
            <Button x:Name="ChooseFolderButton" Content="ローカルフォルダを選ぶ" Click="ChooseFolder_Click" />
            <Button x:Name="SamplesButton" Content="同梱ダミーに戻す" Click="Samples_Click" />
          </StackPanel>
          <Button x:Name="CancelReadButton" Content="読取りを中止" Click="CancelRead_Click" Visibility="Collapsed" />
          <StackPanel x:Name="PreviewButtons" Orientation="Vertical" HorizontalAlignment="Left" Spacing="8">
            <Button x:Name="ListButton" Content="一覧" Click="List_Click" />
            <Button x:Name="GravityButton" Content="重力プレビュー" Click="Gravity_Click" />
            <Button x:Name="PauseButton" Content="一時停止" Click="Pause_Click" Visibility="Collapsed" />
            <Button x:Name="ResetButton" Content="配置を戻す" Click="Reset_Click" Visibility="Collapsed" />
          </StackPanel>
        </StackPanel>

        <Border
            x:Name="ListPanel"
            Grid.Row="4"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    Padding="16,10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.4*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="ファイル名" />
                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="種類" />
                    <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="更新日時" />
                </Grid>

                <ListView
                    Grid.Row="1"
                    ItemsSource="{x:Bind Files, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:FileItem">
                            <Grid Padding="12,8" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.4*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Kind}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind ModifiedAtText}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Grid x:Name="GravityPanel" Grid.Row="4" Visibility="Collapsed" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="GravityHint" Text="種類ごとにまとまる表示試作です。ドラッグは画面上だけ。狭い画面ではスクロールできます。" TextWrapping="Wrap" />
            <ScrollViewer x:Name="GravityScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled">
                <Canvas x:Name="GravityCanvas" Width="1000" Height="600" Background="#F3F6FA" SizeChanged="Canvas_SizeChanged" />
            </ScrollViewer>
        </Grid>

        <TextBlock x:Name="DetailText" Grid.Row="5" Text="カードを選ぶと名前・種類・更新日時を確認できます（ファイルは開きません）。" TextWrapping="Wrap" />

        <TextBlock
            x:Name="StatusText"
            Grid.Row="6"
            TextWrapping="Wrap"
            FontWeight="SemiBold"
            Text="状態: 読み込み前です（ファイル変更は行いません）" />
    </Grid>
    </ScrollViewer>
</Page>
